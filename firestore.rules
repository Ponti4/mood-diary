rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validDate(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])$');
    }

    function validTimestamp(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+Z$');
    }

    function validEntry(entryId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['date', 'emotion', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['date', 'emotion', 'note', 'createdAt', 'updatedAt'])
        && data.date == entryId
        && validDate(data.date)
        && data.emotion in ['happy', 'depressed', 'angry', 'neutral']
        && data.note is string
        && data.note.size() >= 1
        && data.note.size() <= 100
        && data.note.matches('.*[^\\s].*')
        && validTimestamp(data.createdAt)
        && validTimestamp(data.updatedAt);
    }

    match /users/{userId}/entries/{entryId} {
      allow read, delete: if owns(userId);
      allow create, update: if owns(userId) && validEntry(entryId);
    }
  }
}
